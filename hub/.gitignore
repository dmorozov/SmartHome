# Runtime state must never be committed — only the starter configs are tracked.

# Home Assistant: keep configuration.yaml + automations.yaml, ignore everything
# else (.storage holds credentials/auth tokens, plus databases, logs, backups).
ha-config/*
!ha-config/configuration.yaml
!ha-config/automations.yaml
!ha-config/scripts.yaml
!ha-config/mqtt.example.yaml

# Mosquitto: persistence database and logs. The config stays tracked, and so do
# the two runtime DIRECTORIES themselves (via .gitkeep) — compose bind-mounts
# them, and compose sets CreateMountpoint, so a missing source is created by
# dockerd as root:root inside this working tree. Note the `dir/*` + negation
# form: git will not descend into an excluded directory, so `mosquitto/data/`
# plus `!mosquitto/data/.gitkeep` would never have worked.
mosquitto/data/*
!mosquitto/data/.gitkeep
mosquitto/log/*
!mosquitto/log/.gitkeep

# Zigbee2MQTT: only the tracked EXAMPLE starter; the live configuration.yaml
# is ignored on purpose — Z2M rewrites it at runtime and injects the generated
# Zigbee network key on first start, so it must never be committable.
z2m-data/*
!z2m-data/configuration.example.yaml

# go2rtc: only the tracked EXAMPLE starter; the live go2rtc.yaml is ignored —
# stream definitions embed camera credentials.
go2rtc/*
!go2rtc/go2rtc.example.yaml

# ring-mqtt: only the tracked EXAMPLE starter. The live config.json embeds
# the `ring` MQTT password, and the directory accumulates runtime state
# including the Ring REFRESH TOKEN — none of it may ever be committable.
ring-mqtt-data/*
!ring-mqtt-data/config.example.json

# The laptop/appliance Hub's long-lived Panel token (phase-1 bring-up).
token

# Secrets in any form.
secrets.yaml
secret.yaml
*.env
passwd
# mosquitto_passwd 2.1 writes a `<file>.backup.XXXXXX` next to the file it edits
# — same hashes, same secrecy, and `passwd` alone does not match it.
passwd.backup.*
