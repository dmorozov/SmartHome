# Home Assistant rewrites its config directory at runtime: .storage holds
# credentials and the long-lived token, plus the database, logs and the
# files onboarding generates. Track only what we author.
ha-config/*
!ha-config/configuration.yaml
!ha-config/packages/

# The Panel long-lived token. Never commit it.
token

# ring-mqtt runtime state: holds the Ring REFRESH TOKEN. Never commit any
# of it — there is nothing authored in this directory.
ring-mqtt-data/

# Mosquitto: persistence database (config stays tracked).
mosquitto/data/

# go2rtc: only the tracked EXAMPLE starter and the README; the live
# go2rtc.yaml is ignored — stream definitions embed camera credentials, and
# since 2026-08-08 a Ring refresh token. Deny-all + allowlist, so anything new
# dropped in here is ignored by default and has to be named to be tracked.
go2rtc/*
!go2rtc/go2rtc.example.yaml
!go2rtc/README.md
