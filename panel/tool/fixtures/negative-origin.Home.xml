  </room>
  <room id="r-gbath" level="level0" name="Guest Bathroom">
    <point x="1400" y="400"/><point x="1650" y="400"/><point x="1650" y="900"/><point x="1400" y="900"/>
  </room>
  <room id="r-laundry" level="level0" name="Laundry">
    <point x="1650" y="400"/><point x="1900" y="400"/><point x="1900" y="900"/><point x="1650" y="900"/>
  </room>

  <!-- Ground exterior shell -->
  <wall id="w1" level="level0" xStart="300" yStart="-200" xEnd="1900" yEnd="-200" height="250" thickness="10"/>
  <wall id="w2" level="level0" xStart="1900" yStart="-200" xEnd="1900" yEnd="900" height="250" thickness="10"/>
  <wall id="w3" level="level0" xStart="300" yStart="900" xEnd="1900" yEnd="900" height="250" thickness="10"/>
  <wall id="w4" level="level0" xStart="300" yStart="-200" xEnd="300" yEnd="0" height="250" thickness="10"/>
