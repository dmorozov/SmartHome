# {{ ansible_managed }}
# THE source of truth for the kiosk unit (cage wiki recipe + spike tweaks +
# empirical fixes; the static copy retired with the bash path 2026-07-30).
# Reference listing with rationale: docs/research/flutter-cage-spike.md Step 8.

[Unit]
Description=Cage Wayland compositor on %I
# Make sure we are started after logins are permitted. If Plymouth is
# used, we want to start when it is on its way out.
After=systemd-user-sessions.service plymouth-quit-wait.service
# Since we are part of the graphical session, make sure we are started
# before it is complete.
Before=graphical.target
# On systems without virtual consoles, do not start.
ConditionPathExists=/dev/tty0
# Never park the unit in 'failed' with a dead screen. (Belongs in [Unit]
# per systemd.unit(5) — in [Service] it is only a backward-compat alias.)
StartLimitIntervalSec=0
# D-Bus is necessary for contacting logind, which is required.
Wants=dbus.socket systemd-logind.service
After=dbus.socket systemd-logind.service
# Replace any (a)getty that may have spawned, since we log in
# automatically.
Conflicts=getty@%i.service
After=getty@%i.service

[Service]
Type=simple
ExecStart=/usr/bin/cage {{ kiosk_app }}
ExecStartPost=+sh -c "tty_name='%i'; exec chvt $${tty_name#tty}"
Restart=always
RestartSec=1
{% if wlr_drm_devices %}
# Hybrid-GPU pin (runbook Step 0a): keep the compositor off the NVIDIA card.
Environment=WLR_DRM_DEVICES={{ wlr_drm_devices }}
{% endif %}
{% if kiosk_wlr_no_devices %}
# Tolerate a late-enumerating USB touchscreen (cage wiki Troubleshooting).
Environment=WLR_LIBINPUT_NO_DEVICES=1
{% endif %}
{% if panel_hub_kind %}
# Panel settings, resolved environment-first (panel/lib/config/hub_config.dart).
# This is the delivery half of that change: the Hub's address stops being a
# property of the binary, so a drifted DHCP lease costs a converge and a
# restart instead of a Flutter rebuild.
#
# NON-SECRETS ONLY on these lines. `systemctl show -p Environment` hands their
# values to any local user without authentication, and this unit file is 0644.
Environment=HUB={{ panel_hub_kind }}
{% endif %}
{% if panel_ha_url %}
# The same species of setting as GO2RTC_URL below, and it took four rounds to
# be treated like one: Home Assistant behind a reverse proxy with basic auth,
# or an ?api_password=, makes this value a secret on a 0644 line. The
# NON-SECRETS rule above is the whole guard here — the Panel's own log stopped
# printing it whole on 2026-08-04 (see appliance/ansible/README.md), but
# `systemctl show -p Environment` is unaffected by anything the Panel does.
Environment=HA_URL={{ panel_ha_url }}
{% endif %}
{% if panel_go2rtc_url %}
# Where go2rtc is, for the camera and doorbell Popups. Guarded separately from
# HUB above because it is independent of it: a Panel on the fake Hub can still
# be pointed at a real go2rtc, and a Panel on the real Hub need not be.
#
# A base address, not a credential — go2rtc is unauthenticated on this box and
# the camera passwords live in hub/go2rtc/go2rtc.yaml — so the NON-SECRETS
# rule above permits this line, and none of the EnvironmentFile= machinery
# below applies to it.
Environment=GO2RTC_URL={{ panel_go2rtc_url }}
{% endif %}
{% if panel_log_level %}
# Same environment-first rule (panel/lib/diagnostics/log.dart), and the reason
# it is delivered here rather than baked in: raising the level on a Panel that
# is already on a wall must not mean rebuilding it. Unset upstream, so no line
# is emitted and the Panel keeps its own per-mode default. A level is not a
# secret, so it belongs in this 0644 unit file rather than in the 0600 file
# below — that is the only reason it sits here. NOT a precedence claim:
# systemd.exec(5) applies these in file order and the LAST assignment wins, so
# anything in EnvironmentFile= would override these lines, not the reverse.
Environment=LOG={{ panel_log_level }}
{% endif %}
{% if panel_video_transport %}
# Which player the Panel dials cameras with — see panel_video_transport in
# group_vars. The rollback switch phase-8 promises in four places; it lives
# here so that promise is true, because a hand-edited unit does not survive
# the next converge.
Environment=VIDEO_TRANSPORT={{ panel_video_transport }}
{% endif %}
{% if panel_video_repaint_pulse %}
# The camera wall's frame pulse, off in the Panel since 2026-09-04 and brought
# back only from here — see panel_video_repaint_pulse in group_vars. Same
# environment-first rule as LOG above, and the same reason for delivering it
# in the unit: restoring a rendering workaround on a wall that has started
# freezing must not mean a Flutter rebuild.
Environment=VIDEO_REPAINT_PULSE={{ panel_video_repaint_pulse }}
{% endif %}
# HA_TOKEN travels by file instead: `systemctl show` reports EnvironmentFiles=
# as a PATH only, never the contents, and the file is 0600 {{ kiosk_user }}.
# systemd (PID 1, root) reads it at every START — so a rotated token needs a
# restart, not a daemon-reload, which is what the Restart cage handler does.
#
# The leading '-' is deliberate. Without it systemd.exec(5) is explicit: "If
# the file does not exist, cannot be read, or contains invalid content, the
# service will fail to start." On a box running the default HUB=fake there is
# no token to have, and a hard requirement would turn "no HA yet" into a dead
# screen restart-looping forever (Restart=always + StartLimitIntervalSec=0 —
# see the [Unit] comment above). When a token IS genuinely missing under
# HUB=ha, the Panel names it far better than systemd can: `hub.configured
# token=absent` in the journal, plus a converge-time assert in the role that
# refuses the combination before it ever reaches this unit.
EnvironmentFile=-{{ panel_env_file }}
User={{ kiosk_user }}
# Log this user with utmp, letting it show up with commands 'w' and
# 'who'. This is needed since we replace (a)getty. On systemd builds without
# utmp (Ubuntu 26.04's 259 reports -UTMP) these two lines are harmless no-ops
# — 'who' shows nothing there, 'w' still works via logind — kept for the
# 24.04 mini PC. Verified clean under systemd-analyze verify on 259
# (runbook re-audit 2026-08-05).
UtmpIdentifier=%I
UtmpMode=user
# A virtual terminal is needed.
TTYPath=/dev/%I
TTYReset=yes
TTYVHangup=yes
TTYVTDisallocate=yes
# Fail to start if not controlling the virtual terminal.
StandardInput=tty-fail

# Set up a full (custom) user session for the user, required by Cage.
PAMName=cage

[Install]
WantedBy=graphical.target
# No Alias=display-manager.service: systemd 255 cannot alias template
# instances ("Cannot alias cage@tty1.service..."), and it is not needed —
# boot-in works via the WantedBy symlink (verified in appliance/test).
DefaultInstance={{ kiosk_tty }}
