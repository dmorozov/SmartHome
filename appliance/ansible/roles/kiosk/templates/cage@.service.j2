# {{ ansible_managed }}
# THE source of truth for the kiosk unit (cage wiki recipe + spike tweaks +
# empirical fixes; the static copy retired with the bash path 2026-07-30).
# Reference listing with rationale: docs/research/flutter-cage-spike.md Step 8.

[Unit]
Description=Cage Wayland compositor on %I
# Make sure we are started after logins are permitted. If Plymouth is
# used, we want to start when it is on its way out.
After=systemd-user-sessions.service plymouth-quit-wait.service
# Since we are part of the graphical session, make sure we are started
# before it is complete.
Before=graphical.target
# On systems without virtual consoles, do not start.
ConditionPathExists=/dev/tty0
# Never park the unit in 'failed' with a dead screen. (Belongs in [Unit]
# per systemd.unit(5) — in [Service] it is only a backward-compat alias.)
StartLimitIntervalSec=0
# D-Bus is necessary for contacting logind, which is required.
Wants=dbus.socket systemd-logind.service
After=dbus.socket systemd-logind.service
# Replace any (a)getty that may have spawned, since we log in
# automatically.
Conflicts=getty@%i.service
After=getty@%i.service

[Service]
Type=simple
ExecStart=/usr/bin/cage {{ kiosk_app }}
ExecStartPost=+sh -c "tty_name='%i'; exec chvt $${tty_name#tty}"
Restart=always
RestartSec=1
{% if wlr_drm_devices %}
# Hybrid-GPU pin (runbook Step 0a): keep the compositor off the NVIDIA card.
Environment=WLR_DRM_DEVICES={{ wlr_drm_devices }}
{% endif %}
{% if kiosk_wlr_no_devices %}
# Tolerate a late-enumerating USB touchscreen (cage wiki Troubleshooting).
Environment=WLR_LIBINPUT_NO_DEVICES=1
{% endif %}
User={{ kiosk_user }}
# Log this user with utmp, letting it show up with commands 'w' and
# 'who'. This is needed since we replace (a)getty.
UtmpIdentifier=%I
UtmpMode=user
# A virtual terminal is needed.
TTYPath=/dev/%I
TTYReset=yes
TTYVHangup=yes
TTYVTDisallocate=yes
# Fail to start if not controlling the virtual terminal.
StandardInput=tty-fail

# Set up a full (custom) user session for the user, required by Cage.
PAMName=cage

[Install]
WantedBy=graphical.target
# No Alias=display-manager.service: systemd 255 cannot alias template
# instances ("Cannot alias cage@tty1.service..."), and it is not needed —
# boot-in works via the WantedBy symlink (verified in appliance/test).
DefaultInstance={{ kiosk_tty }}
